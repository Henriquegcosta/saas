# Arquivos executados no Linux (VM/Docker) precisam de fim de linha LF,
# mesmo quando o repositório é clonado no Windows (core.autocrlf=true).
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
.env.example text eol=lf

# Binários
*.png binary
*.jpg binary
*.jar binary
*.gz  binary
