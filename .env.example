# =====================================================================
# VIGENTRA - variáveis de ambiente
# Copie para ".env" (que NÃO vai para o Git) e preencha os valores.
#   Windows (local):  copy .env.example .env
#   Linux (VM):       cp .env.example /etc/vigentra/vigentra.env
# Sem nenhuma credencial de envio, tudo funciona em MODO DESENVOLVIMENTO:
# as mensagens são geradas em disco e registradas como "não enviadas".
# =====================================================================

# ---------- Banco de dados (MySQL) ----------
VIGENTRA_DB_URL=jdbc:mysql://localhost:3306/vigentra?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8
VIGENTRA_DB_USER=vigentra
VIGENTRA_DB_PASSWORD=troque-esta-senha

# ---------- Aplicação ----------
# Endereço público (usado nos links dos e-mails: confirmação, convite, preferências)
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080
# Chave do "Lembrar acesso" (gere: openssl rand -hex 32)
APP_REMEMBER_ME_KEY=troque-por-uma-chave-aleatoria-longa
# Chave que ASSINA os links de preferências/descadastro (gere: openssl rand -hex 32).
# Se mudar, os links já enviados deixam de funcionar.
APP_SECRET_KEY=troque-por-outra-chave-aleatoria-longa
# E-mails dos OPERADORES DA PLATAFORMA (painel global /plataforma/comunicacao), separados por vírgula.
APP_PLATFORM_ADMINS=
# Pasta dos anexos (fora da pasta pública). Na VM: /var/lib/vigentra/uploads
APP_STORAGE_DIR=./data/uploads
# Arquivo de log. Na VM: /var/log/vigentra/vigentra.log
VIGENTRA_LOG_FILE=logs/vigentra.log
# true quando a aplicação estiver atrás de HTTPS (Nginx + TLS)
SESSION_COOKIE_SECURE=false

# ---------- E-mail (infraestrutura centralizada do VIGENTRA) ----------
# auto  = Brevo (API) se BREVO_API_KEY existir; senão SMTP se MAIL_HOST existir; senão modo desenvolvimento
# brevo | smtp | dev = força o provedor
MAIL_PROVIDER=auto
MAIL_FROM=nao-responda@seudominio.com.br
MAIL_FROM_NAME=VIGENTRA
MAIL_DEV_DIR=./data/emails-dev
# Opção 1 (recomendada): API transacional da Brevo - https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
# Opção 2 (alternativa): SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false

# ---------- WhatsApp Business Cloud API (oficial da Meta) ----------
# Sem token + phone number id o canal fica "não configurado" e NÃO é usado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
# Webhook (status de entrega e descadastro "SAIR"): App Secret do app Meta + token de verificação escolhido por você
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Nomes dos modelos APROVADOS na Meta (ver docs/NOTIFICACOES.md)
WHATSAPP_TEMPLATE_PROXIMO=vigentra_vencimento_proximo
WHATSAPP_TEMPLATE_VENCIDO=vigentra_documento_vencido
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_TEMPLATE_TESTE=hello_world
WHATSAPP_TEMPLATE_TESTE_IDIOMA=en_US
# true = sem credenciais, gera as mensagens em disco para demonstração (NADA é enviado)
WHATSAPP_DEV_MODE=false
WHATSAPP_DEV_DIR=./data/whatsapp-dev

# ---------- SMS ----------
# Nenhum provedor integrado nesta versão (estrutura pronta - ver docs/NOTIFICACOES.md)
SMS_PROVIDER=nenhum

# ---------- Rotina de alertas ----------
# Cron do Spring: segundo minuto hora dia mês dia-da-semana (padrão: todo dia às 07:00)
ALERTS_CRON=0 0 7 * * *
ALERTS_RETRY_CRON=0 15 * * * *
ALERTS_ENABLED=true
